   "source": [
    "## zip\n",
    "\n",
    "listA = (\"a\",\"b\",\"c\")\n",
    "listB = (\"d\",\"e\",\"f\")\n",
    "\n",
    "combine = zip(listA, listB)\n",
    "\n",
    "print(tuple(combine))"
   ]
  },
